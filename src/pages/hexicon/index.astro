---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import HexiconStats from "../../components/projects/HexiconStats.astro";
import HexiconCastHero from "../../components/projects/HexiconCastHero.astro";
const media = "/hexicon/assets/2026-09";
const features = [
  { image:"01-character", title:"Meet your spellcaster.", eyebrow:"A DIFFERENT START", copy:"Unlock characters with their own runes, relics, and starting kits. Find the one that suits your wordplay.", alt:"Bumble the Beekeeper on Hexicon’s character selection screen", campaign:"02-characters" },
  { image:"03-runes", title:"Make every rune matter.", eyebrow:"SHAPE YOUR POUCH", copy:"Enhance your letters and choose what stays in your pouch. Your next word starts with the runes you build.", alt:"The current rune enhancement screen, choosing a rune to give Root", campaign:"04-runes" },
  { image:"04-shop", title:"One find changes a run.", eyebrow:"RELICS, POTIONS & POSSIBILITIES", copy:"Visit the shop for relics, potions, packs, and upgrades. Put together combinations worth spelling for.", alt:"Hexicon’s shop with separate shelves for enhancements, runes, relics, packs, and items", campaign:"05-relics" },
  { image:"05-mystery", title:"Follow your curiosity.", eyebrow:"SOMETHING OFF THE PATH", copy:"A quiet spring. A tempting trade. A chance worth taking. Explore mystery encounters and choose what to bring with you.", alt:"The Clear Spring encounter offering a recipe upgrade", campaign:"06-mysteries" },
  { image:"boss-moonbell_heights", title:"Read the room. Then cast.", eyebrow:"GUARDIANS WITH THEIR OWN RULES", copy:"Each region ends with a guardian. Learn what makes it dangerous, then find the words your build needs.", alt:"CHARM staged against the Astral Carillon, guardian of Moonbell Heights", campaign:"07-bosses" },
  { image:"06-collection", title:"Keep finding new ideas.", eyebrow:"A GROWING COLLECTION", copy:"Browse characters, relics, and items in your collection. Turn a new discovery into a plan for your next run.", alt:"The searchable collection of characters and relics", campaign:"08-collection" },
];
const regions = [
  { id:"brambleways", name:"The Brambleways", copy:"Free a garden trapped in endless spring." },
  { id:"porcelain_quarter", name:"Porcelain Quarter", copy:"Break the mold that holds a town." },
  { id:"moonbell_heights", name:"Moonbell Heights", copy:"Release the moon from its song." },
  { id:"unwritten_archive", name:"Unwritten Archive", copy:"Preserve the worlds within the pages." },
];
---
<BaseLayout title="Hexicon · Words are your spells · Pocket Powered" description="Words are your spells. Choose your character, shape your runes, combine relics, and explore four strange regions in Hexicon, a word-building roguelike for Android and iPhone." image="/hexicon/assets/2026-09/social.png" themeColor="#14292b" bodyClass="hexicon-page">
  <SiteHeader />
  <main>
    <section class="hx-hero shell" aria-labelledby="hexicon-title">
      <div class="hx-hero-copy">
        <div class="hx-brand"><img src="/hexicon/assets/store/app-icon.svg" alt="" width="52" height="52" /><p class="hx-eyebrow">HEXICON / WORDS ARE YOUR SPELLS</p></div>
        <h1 id="hexicon-title">A little wordplay.<br /><em>A world of magic.</em></h1>
        <p class="hx-lede">Spell clever words. Shape your runes. Find the relic that makes it all click. Your path through four strange regions starts with a handful of letters.</p>
        <HexiconStats />
        <div class="hx-actions"><a class="hx-button" href="#beta">Play the beta <span aria-hidden="true">↓</span></a><a class="hx-text-link" href="#how-to-play">Find your kind of magic</a></div>
        <p class="hx-note">Android + iPhone <span>·</span> Single player <span>·</span> Play offline</p>
      </div>
      <HexiconCastHero />
    </section>
    <section class="hx-word-strip" aria-label="The shape of a run"><div class="shell hx-word-inner"><p>A good word is a start.<br /><strong>A clever build makes it yours.</strong></p><ol><li>Choose your character</li><li>Find your path</li><li>Build your magic</li></ol></div></section>
    <section id="how-to-play" class="hx-loop shell" aria-labelledby="loop-title">
      <div class="hx-section-heading"><p class="hx-eyebrow">MORE THAN THE WORDS YOU KNOW</p><h2 id="loop-title">Small letters.<br /><em>So many possibilities.</em></h2><p>Your vocabulary opens the door. Your choices shape what happens next.</p></div>
      <div class="hx-features">{features.map((feature) => <article class="hx-feature"><div class="hx-feature-copy"><p class="hx-eyebrow">{feature.eyebrow}</p><h3>{feature.title}</h3><p>{feature.copy}</p></div><a class="hx-native-screen" href={`${media}/${feature.image}.png`} aria-label={`View full-size screenshot: ${feature.alt}`}><img src={`${media}/${feature.image}.webp`} alt={feature.alt} width="390" height="844" loading="lazy" /></a></article>)}</div>
      <p class="hx-caption">Captured in the current game. Tap a screen for a closer look.</p>
    </section>
    <section class="hx-worlds" aria-labelledby="worlds-title"><div class="shell">
      <div class="hx-section-heading"><p class="hx-eyebrow">FOUR REGIONS. FOUR GUARDIANS.</p><h2 id="worlds-title">A strange world.<br /><em>Worth finding your way through.</em></h2><p>Take branching paths through overgrown gardens, cracked streets, moonlit heights, and an archive of worlds. Discover encounters along the way and face the magic holding each place captive.</p></div>
      <div class="hx-regions">{regions.map((region) => <figure><a href={`${media}/region-${region.id}.png`} aria-label={`View ${region.name} in Hexicon`}><img src={`${media}/region-${region.id}.webp`} alt={`${region.name} region introduction, with its guardian and native story artwork`} width="390" height="844" loading="lazy" /></a><figcaption><h3>{region.name}</h3><p>{region.copy}</p></figcaption></figure>)}</div>
    </div></section>
    <section id="beta" class="hx-beta shell" aria-labelledby="beta-title">
      <div class="hx-beta-intro"><p class="hx-eyebrow">THE NEXT CHAPTER</p><h2 id="beta-title">Put a little magic<br /><em>in your pocket.</em></h2><p>Explore the Hexicon beta on Android or iPhone. Help shape the game with your wordplay, wild combinations, and feedback.</p></div>
      <div class="hx-beta-platforms">
        <article class="hx-beta-details" aria-labelledby="android-beta-title">
          <span class="hx-status">ANDROID BETA · UNITED STATES</span>
          <h3 id="android-beta-title">Play on Android.</h3>
          <div class="hx-beta-actions">
            <a class="hx-button" href="/hexicon/go/android-group" target="_blank" rel="noopener"><span>1. Join the tester group<small>Use your phone’s Google account</small></span><span aria-hidden="true">↗</span></a>
            <a class="hx-button" href="/hexicon/go/android" target="_blank" rel="noopener"><span>2. Join the Android beta<small>Same account · Tap “Become a tester”</small></span><span aria-hidden="true">↗</span></a>
            <a class="hx-button" href="/hexicon/go/android-store" target="_blank" rel="noopener"><span>3. Install from Google Play<small>Free · Android 7 or later</small></span><span aria-hidden="true">↗</span></a>
          </div>
          <a class="hx-support" href="mailto:hello@pocketpowered.org?subject=Hexicon%20Android%20beta">Need help joining? Get in touch.</a>
        </article>
        <article class="hx-beta-details" aria-labelledby="ios-beta-title">
          <span class="hx-status">IPHONE BETA · OPEN</span>
          <h3 id="ios-beta-title">Play on iPhone.</h3>
          <div class="hx-beta-actions">
            <a class="hx-button" href="https://apps.apple.com/app/testflight/id899247664" target="_blank" rel="noopener"><span>1. Install TestFlight<small>Free · iOS 16 or later</small></span><span aria-hidden="true">↗</span></a>
            <a class="hx-button" href="/hexicon/go/ios" target="_blank" rel="noopener"><span>2. Join the iPhone beta<small>Open on your iPhone · Tap “Accept”, then “Install”</small></span><span aria-hidden="true">↗</span></a>
          </div>
          <a class="hx-support" href="mailto:hello@pocketpowered.org?subject=Hexicon%20iPhone%20beta">Need help joining? Get in touch.</a>
        </article>
      </div>
      <a class="hx-support" href="/hexicon/privacy/">Hexicon privacy policy</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  :global(.hexicon-page) { background:#f3eddf; color:#243633; --ink:#243633; --paper:#f3eddf; --yellow:#d7b86c; }
  .hx-hero { display:grid; grid-template-columns:1.1fr 1fr; align-items:center; gap:44px; padding-block:65px 85px; }
  .hx-brand { display:flex; align-items:center; gap:14px; }
  .hx-brand img { flex-shrink:0; border-radius:12px; }
  .hx-eyebrow { font-size:.68rem; font-weight:800; letter-spacing:.14em; line-height:1.6; }
  h1,h2,h3 { font-family:Georgia,'Times New Roman',serif; font-weight:400; }
  h1 { font-size:clamp(3rem,5vw,4.65rem); line-height:1.04; letter-spacing:-.055em; margin:26px 0; }
  h1 em,h2 em { color:#526b55; font-weight:400; }
  .hx-lede { max-width:31rem; font-size:1.1rem; line-height:1.8; }
  .hx-actions { display:flex; flex-wrap:wrap; gap:24px; align-items:center; margin-top:30px; }
  .hx-button { display:inline-flex; justify-content:center; align-items:center; gap:22px; background:#d7b86c; color:#172127; border:1px solid #a88d48; border-radius:7px; padding:15px 22px; font-weight:700; text-decoration:none; min-height:50px; transition:background .15s; }
  .hx-button:hover { background:#e8ca7f; }
  .hx-text-link { text-underline-offset:5px; font-size:.9rem; font-weight:700; }
  .hx-note { color:#58655c; font-size:.78rem; margin-top:25px; }
  .hx-note span { padding-inline:6px; }
  .hx-word-strip { background:#243633; color:#f3eddf; padding:25px 0; }
  .hx-word-inner { display:flex; justify-content:space-between; align-items:center; gap:24px; }
  .hx-word-inner p { font-size:1rem; line-height:1.8; }
  .hx-word-inner ol { display:flex; gap:38px; padding-left:22px; color:#d7b86c; font-size:.85rem; }
  .hx-word-inner li { padding-left:3px; }
  .hx-loop { padding-block:85px; scroll-margin-top:25px; }
  .hx-section-heading { max-width:740px; margin-bottom:45px; }
  h2 { font-size:clamp(2.3rem,4vw,3.5rem); letter-spacing:-.045em; line-height:1.12; margin:20px 0; }
  .hx-section-heading > p:last-child { max-width:620px; font-size:1.05rem; line-height:1.8; }
  h3 { font-size:1.65rem; line-height:1.2; margin:14px 0; letter-spacing:-.025em; }
  .hx-features { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:26px; }
  .hx-feature { border:1px solid #c4c7b4; border-radius:16px; overflow:hidden; background:#e7e7d9; display:flex; flex-direction:column; }
  .hx-feature:nth-child(3n+2) { background:#e8dfcf; }
  .hx-feature:nth-child(3n+3) { background:#e0e3dc; }
  .hx-feature-copy { padding:26px 26px 18px; }
  .hx-feature-copy .hx-eyebrow { font-size:.6rem; color:#526b55; }
  .hx-feature-copy > p:last-child { font-size:.9rem; line-height:1.7; margin-bottom:0; }
  .hx-native-screen { display:block; margin:12px 30px 30px; border:1px solid #7a8b76; border-radius:10px; overflow:hidden; box-shadow:0 10px 25px #152c2922; margin-top:auto; }
  .hx-native-screen img { width:100%; height:auto; }
  .hx-caption { font-size:.8rem; color:#58655c; text-align:center; margin:28px 0 0; }
  .hx-worlds { background:#14292b; color:#f3eddf; padding-block:80px; }
  .hx-worlds .hx-eyebrow { color:#d7b86c; }
  .hx-worlds h2 em { color:#c0d0aa; }
  .hx-worlds .hx-section-heading > p:last-child { color:#cbd0c4; }
  .hx-regions { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:22px; }
  .hx-regions figure { margin:0; }
  .hx-regions img { border:1px solid #5b6b5d; border-radius:10px; width:100%; height:auto; }
  .hx-regions h3 { font-size:1.25rem; margin-top:20px; }
  .hx-regions p { color:#cbd0c4; font-size:.85rem; line-height:1.6; }
  .hx-beta { padding-block:85px; scroll-margin-top:25px; }
  .hx-beta p { max-width:480px; line-height:1.7; }
  .hx-beta-intro { margin-bottom:36px; }
  .hx-beta-platforms { display:grid; grid-template-columns:1fr 1fr; gap:24px; }
  .hx-beta-details { padding:32px; border:1px solid #b6bdaa; border-radius:12px; }
  .hx-beta-actions { display:grid; gap:12px; }
  .hx-beta-actions .hx-button { justify-content:space-between; text-align:left; }
  .hx-beta-actions small { display:block; margin-top:4px; font-size:.75rem; font-weight:400; line-height:1.4; }
  .hx-status { font-size:.68rem; font-weight:800; letter-spacing:.08em; color:#526b55; }
  .hx-support { display:block; margin-top:20px; font-size:.85rem; text-underline-offset:4px; }
  @media(max-width:1050px) { .hx-features { gap:18px; } .hx-feature-copy { padding:22px 20px; } .hx-native-screen { margin-inline:20px; } .hx-word-inner ol { gap:24px; } }
  @media(max-width:800px) { .hx-hero { grid-template-columns:1fr; padding-block:30px 55px; gap:32px; } .hx-hero-copy { max-width:620px; } .hx-features { grid-template-columns:repeat(2,minmax(0,1fr)); } .hx-regions { grid-template-columns:repeat(2,minmax(0,1fr)); gap:28px; } .hx-word-inner { flex-direction:column; align-items:flex-start; gap:0; } .hx-beta-platforms { grid-template-columns:1fr; } }
  @media(max-width:500px) { .hx-features { grid-template-columns:1fr; gap:24px; } .hx-feature-copy { padding:26px; } .hx-native-screen { width:calc(100% - 68px); max-width:300px; margin:4px auto 30px; } .hx-loop,.hx-worlds { padding-block:55px; } .hx-section-heading { margin-bottom:32px; } .hx-regions { gap:18px; } .hx-regions h3 { font-size:1.15rem; } .hx-word-inner ol { flex-direction:column; gap:8px; margin-block:8px 12px; } .hx-beta { padding-block:55px; } .hx-beta-details { padding:24px; } }
  @media(max-width:360px) { .hx-brand { gap:10px; } .hx-brand .hx-eyebrow { font-size:.6rem; } .hx-actions { gap:18px; } }
  @media(prefers-reduced-motion:reduce) { .hx-button { transition:none; } }
</style>
