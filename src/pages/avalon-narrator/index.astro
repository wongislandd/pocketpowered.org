---
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Announcer for Avalon · Pocket Powered"
  description="An offline Avalon narrator that builds a correct announcement sequence from your exact role setup."
  bodyClass="project-page"
>
  <SiteHeader compact />

  <main class="avalon-project">
    <section class="avalon-project__hero shell">
      <div class="avalon-project__intro">
        <p class="kicker">Avalon game night · Open source project</p>
        <h1>Simplify the Avalon setup narration</h1>
        <p class="avalon-project__lede">Get into your Avalon round without hiccups</p>
        <div class="avalon-project__actions">
          <a class="button button--yellow" href="https://wongislandd.github.io/avalon-narrator/" target="_blank" rel="noopener">Try the web app <span aria-hidden="true">↗</span></a>
          <a class="button button--paper" href="https://github.com/wongislandd/avalon-narrator" target="_blank" rel="noopener">View source on GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="avalon-project__hero-art" aria-label="Announcer for Avalon app icon">
        <div class="avalon-project__ring" aria-hidden="true"></div>
        <img src="/avalon-narrator/assets/app-logo.png" alt="Announcer for Avalon app icon" width="192" height="192" />
      </div>
    </section>

    <section class="avalon-project__walkthrough shell" aria-labelledby="avalon-walkthrough-title">
      <div class="section-heading">
        <p class="kicker">How it works</p>
        <h2 id="avalon-walkthrough-title">Choose the characters. Press play.</h2>
        <p>Pick the characters your table is using, then let Announcer for Avalon take care of the rest of the opening sequence.</p>
      </div>

      <div class="avalon-project__walkthrough-grid">
        <figure>
          <div class="avalon-project__shot">
            <img src="/avalon-narrator/screenshots/01-iphone-setup.png" alt="Announcer for Avalon setup screen with character selection" width="1284" height="2778" loading="lazy" />
          </div>
          <figcaption><span>01 · iPhone</span><h3>Choose the characters</h3><p>Start with the roles in tonight’s game.</p></figcaption>
        </figure>

        <figure>
          <div class="avalon-project__shot">
            <img src="/avalon-narrator/screenshots/02-iphone-role-preview.png" alt="Announcer for Avalon iPhone role preview overlay for Merlin" width="1284" height="2778" loading="lazy" />
          </div>
          <figcaption><span>02 · iPhone</span><h3>Preview a role</h3><p>Check what each character does before the game begins.</p></figcaption>
        </figure>

        <figure>
          <div class="avalon-project__shot">
            <img src="/avalon-narrator/screenshots/03-iphone-good-roles.png" alt="Announcer for Avalon iPhone screen for selecting good roles" width="1284" height="2778" loading="lazy" />
          </div>
          <figcaption><span>03 · iPhone</span><h3>Review the lineup</h3><p>Make the final role choices for tonight’s round.</p></figcaption>
        </figure>

        <figure>
          <div class="avalon-project__shot">
            <img src="/avalon-narrator/screenshots/04-iphone-narrator.png" alt="Announcer for Avalon iPhone narrator chamber playback timeline" width="1284" height="2778" loading="lazy" />
          </div>
          <figcaption><span>04 · iPhone</span><h3>Run the narration</h3><p>Play the opening sequence and get straight into the round.</p></figcaption>
        </figure>
      </div>
    </section>

    <section class="avalon-project__stack" aria-labelledby="avalon-stack-title">
      <div class="shell">
        <p class="kicker kicker--light">Built once, shared everywhere</p>
        <h2 id="avalon-stack-title">Kotlin Multiplatform for Android, iPhone, and Web.</h2>
        <p>One shared domain model carries setup validation, narration planning, playback, and persistence across the three targets.</p>
        <a class="text-link" href="https://github.com/wongislandd/avalon-narrator" target="_blank" rel="noopener">Read the code and the decisions behind it <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .avalon-project {
    background: var(--cream);
  }

  .avalon-project__hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    min-height: min(720px, calc(100vh - 76px));
    align-items: center;
    gap: clamp(40px, 8vw, 110px);
    padding-block: clamp(68px, 10vw, 120px);
  }

  .avalon-project__intro h1 {
    max-width: 760px;
    margin: 14px 0 26px;
    font-size: clamp(4rem, 8vw, 7.8rem);
    line-height: 0.84;
    letter-spacing: -0.08em;
  }

  .avalon-project__lede {
    max-width: 590px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.2rem, 2.3vw, 1.65rem);
  }

  .avalon-project__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .avalon-project__hero-art {
    position: relative;
    display: grid;
    min-height: 420px;
    place-items: center;
    overflow: hidden;
    border: 3px solid var(--ink);
    border-radius: 28px;
    background:
      radial-gradient(circle at 50% 44%, color-mix(in srgb, var(--orange), transparent 24%) 0 13%, transparent 13.5%),
      radial-gradient(circle at 50% 44%, color-mix(in srgb, var(--orange), transparent 72%) 0 36%, transparent 36.5%),
      var(--ink-deep);
    box-shadow: var(--shadow);
    isolation: isolate;
  }

  .avalon-project__hero-art::before,
  .avalon-project__hero-art::after {
    position: absolute;
    width: 150%;
    height: 150%;
    border: 1px solid color-mix(in srgb, var(--orange), transparent 50%);
    border-radius: 50%;
    content: "";
    transform: rotate(22deg);
  }

  .avalon-project__hero-art::after {
    width: 110%;
    height: 110%;
    border-color: color-mix(in srgb, var(--yellow), transparent 66%);
    transform: rotate(-20deg);
  }

  .avalon-project__hero-art img {
    position: relative;
    z-index: 1;
    width: min(48%, 192px);
    border: 4px solid var(--paper);
    border-radius: 30px;
    box-shadow: 10px 10px 0 var(--orange);
    transform: rotate(-6deg);
  }

  .avalon-project__ring {
    position: absolute;
    width: 250px;
    aspect-ratio: 1;
    border: 2px solid var(--orange);
    border-radius: 50%;
    box-shadow: 0 0 0 16px color-mix(in srgb, var(--orange), transparent 82%), 0 0 0 34px color-mix(in srgb, var(--yellow), transparent 90%);
    transform: rotate(18deg) scaleY(0.42);
  }

  .avalon-project__stack {
    padding-block: clamp(76px, 10vw, 120px);
    background: var(--ink-deep);
    color: var(--paper);
  }

  .avalon-project__walkthrough {
    padding-bottom: clamp(90px, 12vw, 150px);
  }

  .avalon-project__walkthrough .section-heading {
    max-width: 760px;
  }

  .avalon-project__walkthrough .section-heading > p:last-child {
    max-width: 650px;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 1.12rem;
  }

  .avalon-project__walkthrough-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 34px 18px;
  }

  .avalon-project__walkthrough-grid figure {
    margin: 0;
  }

  .avalon-project__shot {
    overflow: hidden;
    border: 3px solid var(--ink);
    border-radius: 20px;
    background: var(--ink-deep);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .avalon-project__shot img {
    width: 100%;
    height: auto;
  }

  .avalon-project__walkthrough-grid figcaption {
    padding: 20px 4px 0;
  }

  .avalon-project__walkthrough-grid figcaption span {
    color: var(--orange);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .avalon-project__walkthrough-grid h3 {
    margin: 9px 0 8px;
    font-size: 1.45rem;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .avalon-project__walkthrough-grid figcaption p {
    margin: 0;
    color: var(--muted);
  }

  .avalon-project__stack h2 {
    max-width: 800px;
    margin: 10px 0 20px;
    font-size: clamp(2.7rem, 6vw, 5.4rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .avalon-project__stack p:not(.kicker) {
    max-width: 650px;
    margin: 0 0 24px;
    color: color-mix(in srgb, var(--paper), transparent 16%);
    font-size: 1.2rem;
  }

  .avalon-project__stack .text-link {
    color: var(--paper);
  }

  @media (max-width: 900px) {
    .avalon-project__hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .avalon-project__hero-art {
      min-height: 360px;
    }

    .avalon-project__walkthrough-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .avalon-project__intro h1 {
      font-size: clamp(3.8rem, 18vw, 6rem);
    }

    .avalon-project__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .avalon-project__walkthrough-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
