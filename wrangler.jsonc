{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pocketpowered-site",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "pocketpowered.org",
      "custom_domain": true
    },
    {
      "pattern": "www.pocketpowered.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/sidequests/config.json", "/sidequests/go/*"]
  },
  "vars": {
    "ANDROID_GROUP_URL": "https://groups.google.com/g/sidequests-nyc-early-access",
    "ANDROID_PLAY_URL": "https://play.google.com/apps/internaltest/4701610219987561935",
    "ANDROID_STATUS": "open",
    "IOS_TESTFLIGHT_URL": "",
    "IOS_STATUS": "review",
    "EARLY_ACCESS_GUIDE_URL": "https://docs.google.com/document/d/1O3SjviYis1uR3GOcwNLuJHYrS49x_qRd01YyXkET56o/view"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
