---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
---

<article class="avalon-feature">
  <div class="avalon-feature__visual">
    <div class="avalon-feature__halo" aria-hidden="true"></div>
    <img src="/avalon-narrator/assets/app-logo.png" alt="Announcer for Avalon app icon" width="192" height="192" />
  </div>

  <div class="avalon-feature__copy">
    <div class="avalon-feature__meta">
      <span class="avalon-feature__status">{data.statusLabel}</span>
      <span>{data.platforms.join(" · ")}</span>
    </div>
    <h3>{data.name}</h3>
    <p>{data.summary}</p>
    <div class="avalon-feature__actions">
      <a class="button button--yellow" href={data.href}>See the project <span aria-hidden="true">→</span></a>
      {data.githubUrl && <a class="text-link" href={data.githubUrl} target="_blank" rel="noopener">View on GitHub <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
</article>

<style>
  .avalon-feature {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    overflow: hidden;
    border: 3px solid var(--ink);
    border-radius: 28px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: var(--shadow);
  }

  .avalon-feature__visual {
    position: relative;
    display: grid;
    min-height: 390px;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 50% 46%, color-mix(in srgb, var(--orange), transparent 28%) 0 12%, transparent 12.5%),
      radial-gradient(circle at 50% 46%, color-mix(in srgb, var(--orange), transparent 70%) 0 34%, transparent 34.5%),
      var(--ink-deep);
  }

  .avalon-feature__visual::before,
  .avalon-feature__visual::after {
    position: absolute;
    width: 170%;
    height: 170%;
    border: 1px solid color-mix(in srgb, var(--orange), transparent 52%);
    border-radius: 50%;
    content: "";
    transform: rotate(24deg);
  }

  .avalon-feature__visual::after {
    width: 120%;
    height: 120%;
    border-color: color-mix(in srgb, var(--yellow), transparent 66%);
    transform: rotate(-18deg);
  }

  .avalon-feature__halo {
    position: absolute;
    width: 230px;
    aspect-ratio: 1;
    border: 2px solid var(--orange);
    border-radius: 50%;
    box-shadow: 0 0 0 14px color-mix(in srgb, var(--orange), transparent 82%), 0 0 0 30px color-mix(in srgb, var(--yellow), transparent 90%);
    transform: rotate(18deg) scaleY(0.42);
  }

  .avalon-feature__visual img {
    position: relative;
    z-index: 1;
    width: clamp(140px, 18vw, 192px);
    border: 4px solid var(--paper);
    border-radius: 30px;
    box-shadow: 10px 10px 0 var(--orange);
    transform: rotate(-5deg);
  }

  .avalon-feature__copy {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    padding: clamp(34px, 6vw, 72px);
  }

  .avalon-feature__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    color: color-mix(in srgb, var(--paper), transparent 12%);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .avalon-feature__status {
    display: inline-flex;
    padding: 7px 12px;
    border: 2px solid var(--paper);
    border-radius: 999px;
    background: var(--orange);
    color: var(--ink-deep);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  h3 {
    max-width: 540px;
    margin: 20px 0;
    font-size: clamp(2.35rem, 5vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .avalon-feature__copy > p {
    max-width: 580px;
    margin: 0 0 28px;
    color: color-mix(in srgb, var(--paper), transparent 10%);
    font-size: 1.14rem;
  }

  .avalon-feature__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 24px;
  }

  .avalon-feature__actions .text-link {
    color: var(--paper);
  }

  @media (max-width: 900px) {
    .avalon-feature {
      grid-template-columns: 1fr;
    }

    .avalon-feature__visual {
      min-height: 330px;
    }
  }

  @media (max-width: 680px) {
    .avalon-feature__copy {
      padding: 32px;
    }

    .avalon-feature__visual {
      min-height: 300px;
    }
  }

  @media (max-width: 440px) {
    .avalon-feature__actions {
      align-items: stretch;
      flex-direction: column;
      width: 100%;
    }
  }
</style>
