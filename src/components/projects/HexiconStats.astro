---
import { stats } from "../../data/hexicon-stats.json";
---
<dl class="hexicon-stats" aria-label="Discover in Hexicon">
  {stats.map((stat) => <div><dt>{stat.label}</dt><dd class="count">{stat.count}</dd><dd class="purpose">{stat.purpose}</dd></div>)}
</dl>
<style>
  .hexicon-stats { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:22px 20px; margin:30px 0; padding-top:24px; border-top:1px solid currentColor; border-color:color-mix(in srgb,currentColor 25%,transparent); }
  .hexicon-stats > div { display:flex; flex-direction:column; min-width:0; }
  dt { font-size:.78rem; font-weight:700; line-height:1.4; }
  .count { order:-1; margin:0 0 5px; color:var(--yellow,#d7b86c); font:normal 2.4rem/1 Georgia,serif; letter-spacing:-.04em; }
  .purpose { margin:5px 0 0; font-size:.72rem; line-height:1.5; opacity:.8; }
  :global(.hexicon-page) .count { color:#526b55; }
</style>
