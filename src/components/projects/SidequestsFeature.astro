---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;

const artwork = [
  {
    src: "/sidequests/assets/starter-pack.jpg",
    alt: "Starter Pack artwork with city objects and photo cards",
  },
  {
    src: "/sidequests/assets/park-life.jpg",
    alt: "Park Life artwork with a fountain, trees, and walking path",
  },
  {
    src: "/sidequests/assets/feline-frenzy.jpg",
    alt: "Feline Frenzy artwork with city cats in neighborhood scenes",
  },
];
---

<article class="sidequests-feature">
  <div class="sidequests-feature__copy">
    <div class="sidequests-feature__meta">
      <span class="sidequests-feature__status">{data.statusLabel}</span>
      <span>{data.platforms.join(" · ")}</span>
    </div>
    <h3>{data.name}</h3>
    <p>{data.summary}</p>
    <a class="sidequests-feature__button" href={data.href}>
      Explore Sidequests <span aria-hidden="true">→</span>
    </a>
  </div>

  <a class="sidequests-feature__art" href={data.href} aria-label="Explore Sidequests NYC">
    {artwork.map((item, index) => (
      <figure class:list={["sidequests-feature__tile", `sidequests-feature__tile--${index + 1}`]}>
        <img src={item.src} alt={item.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
      </figure>
    ))}
  </a>
</article>

<style>
  .sidequests-feature {
    display: grid;
    grid-template-columns: 1.03fr 0.97fr;
    overflow: hidden;
    border: 3px solid var(--ink);
    border-radius: 28px;
    background: var(--yellow);
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  .sidequests-feature__copy {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    padding: clamp(34px, 6vw, 72px);
  }

  .sidequests-feature__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sidequests-feature__status {
    display: inline-flex;
    padding: 7px 12px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--green);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  h3 {
    margin: 20px 0;
    font-size: clamp(2.5rem, 5vw, 4.8rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .sidequests-feature__copy > p {
    max-width: 580px;
    margin: 0 0 28px;
    font-size: 1.14rem;
  }

  .sidequests-feature__button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 20px;
    border: 3px solid var(--ink);
    border-radius: 14px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 900;
    line-height: 1.1;
    text-align: center;
    text-decoration: none;
    transition: box-shadow 150ms ease, transform 150ms ease;
  }

  .sidequests-feature__button:hover {
    box-shadow: 4px 4px 0 var(--ink);
    transform: translate(-2px, -2px);
  }

  .sidequests-feature__art {
    position: relative;
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    grid-template-rows: 1fr 1fr;
    gap: 14px;
    min-height: 560px;
    padding: 34px;
    background: var(--purple);
    text-decoration: none;
  }

  .sidequests-feature__art::after {
    position: absolute;
    right: 18px;
    bottom: 16px;
    padding: 6px 10px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    content: "EXPLORE SIDEQUESTS →";
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .sidequests-feature__tile {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 3px solid var(--ink);
    border-radius: 18px;
    background: var(--paper);
    box-shadow: 6px 6px 0 var(--ink);
    transition: transform 180ms ease;
  }

  .sidequests-feature__tile--1 {
    grid-row: 1 / 3;
    transform: rotate(-2deg);
  }

  .sidequests-feature__tile--2 {
    transform: rotate(2deg);
  }

  .sidequests-feature__tile--3 {
    transform: rotate(-1deg);
  }

  .sidequests-feature__art:hover .sidequests-feature__tile--1 {
    transform: rotate(-3deg) translateY(-3px);
  }

  .sidequests-feature__art:hover .sidequests-feature__tile--2 {
    transform: rotate(3deg) translateY(-3px);
  }

  .sidequests-feature__art:hover .sidequests-feature__tile--3 {
    transform: rotate(-2deg) translateY(-3px);
  }

  .sidequests-feature__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .sidequests-feature {
      grid-template-columns: 1fr;
    }

    .sidequests-feature__art {
      min-height: 500px;
    }
  }

  @media (max-width: 680px) {
    .sidequests-feature__copy {
      padding: 32px;
    }

    .sidequests-feature__art {
      min-height: 400px;
      padding: 22px;
    }
  }

  @media (max-width: 440px) {
    .sidequests-feature__art {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1.15fr 0.85fr;
      min-height: 450px;
    }

    .sidequests-feature__tile--1 {
      grid-column: 1 / 3;
      grid-row: auto;
    }

    .sidequests-feature__button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidequests-feature__button,
    .sidequests-feature__tile {
      transition-duration: 0.01ms;
    }
  }
</style>
