---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
const screenshots = [
  { image:"01-spell", alt:"Words are your spells. Hexicon combat with QUIT prepared as an attack against a Dust Sprite." },
  { image:"02-relics", alt:"Build around your relics. The shop offers runes, relics, packs, and potions." },
  { image:"03-runes", alt:"Make each rune your own. Choose a rune to enhance with Root." },
  { image:"04-bosses", alt:"Learn the boss’s rules. A battle against the Stitch Duchess and her Binding Stitch effect." },
  { image:"05-collection", alt:"Fill your collection. Browse discovered relics and their effects." },
];
---
<BaseLayout title="Hexicon · A word-building roguelike · Pocket Powered" description="Turn letters into spells. Meet curious creatures, collect powerful relics, and build your own kind of magic in Hexicon, a word-building roguelike for iPhone." image="/hexicon/assets/store/overview.png" themeColor="#172127" bodyClass="hexicon-page">
  <SiteHeader />
  <main>
    <section class="hx-hero shell" aria-labelledby="hexicon-title">
      <div class="hx-hero-copy">
        <div class="hx-brand"><img src="/hexicon/assets/store/app-icon.svg" alt="" width="64" height="64" /><p class="hx-eyebrow">HEXICON / A WORD-BUILDING ROGUELIKE</p></div>
        <h1 id="hexicon-title">A little wordplay.<br /><em>A lot of magic.</em></h1>
        <p class="hx-lede">Your letters are your spells. Build clever words, collect curious relics, and take on a world of creatures with a few tricks of their own.</p>
        <div class="hx-actions"><a class="hx-button" href="#beta">Explore the iPhone beta <span aria-hidden="true">↓</span></a><a class="hx-text-link" href="#how-to-play">See how it plays</a></div>
        <p class="hx-note">Single player. Small screen. One more run.</p>
      </div>
      <figure class="hx-hero-art">
        <img src="/hexicon/assets/enemy-walking_grimoire.png" alt="Hexicon’s Walking Grimoire, a scowling teal spellbook with brass corners, boots, and a red bookmark tongue" width="512" height="512" fetchpriority="high" />
        <figcaption><span>MEET THE LOCALS</span><strong>Walking Grimoire</strong><i>Not your usual word game.</i></figcaption>
      </figure>
    </section>
    <section class="hx-word-strip" aria-label="Turn words into magic">
      <div class="shell hx-word-inner"><p>A good vocabulary is a start.<br /><strong>A clever build is where it gets interesting.</strong></p><div class="hx-tiles" aria-label="M A G I C">{["M","A","G","I","C"].map((letter) => <span aria-hidden="true">{letter}</span>)}</div></div>
    </section>
    <section id="how-to-play" class="hx-loop shell" aria-labelledby="loop-title">
      <div class="hx-section-heading"><p class="hx-eyebrow">THE SHAPE OF A RUN</p><h2 id="loop-title">Spell. Collect. <em>Surprise yourself.</em></h2><p>Part word puzzle, part ever-changing strategy. It’s what you do with the letters you draw.</p></div>
      <div class="hx-screenshots" role="region" aria-label="Hexicon gameplay screenshots" tabindex="0">{screenshots.map((shot) => <a class="hx-screen" href={`/hexicon/assets/store/${shot.image}.png`} aria-label={`View full-size screenshot: ${shot.alt}`}><img src={`/hexicon/assets/store/${shot.image}.png`} alt={shot.alt} width="1242" height="2688" loading="lazy" /></a>)}</div>
      <p class="hx-caption">Scroll to explore. Tap a screen for a closer look.</p>
    </section>
    <section id="beta" class="hx-beta shell" aria-labelledby="beta-title">
      <div><p class="hx-eyebrow">THE NEXT CHAPTER</p><h2 id="beta-title">Put a little magic<br /><em>in your pocket.</em></h2><p>Hexicon is in beta for iPhone. Help shape the game with your wordplay, wild combinations, and feedback.</p></div>
      <div class="hx-beta-details"><span class="hx-status">PUBLIC BETA · AWAITING APPLE REVIEW</span><h3>Your invitation is here.</h3><p>The public TestFlight link is ready. New testers can join once Apple approves the build. Requires an iPhone with iOS 16 or later and Apple’s TestFlight app.</p><a class="hx-button" href="/hexicon/go/ios" target="_blank" rel="noopener">View on TestFlight <span aria-hidden="true">↗</span></a><a class="hx-support" href="mailto:hello@pocketpowered.org?subject=Hexicon%20feedback">Questions or feedback? Get in touch.</a></div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  :global(.hexicon-page) { background:#f3eddf; color:#243633; --ink:#243633; --paper:#f3eddf; --yellow:#d7b86c; }
  .hx-hero { display:grid; grid-template-columns:1.12fr 1fr; align-items:center; gap:52px; padding-block:64px 90px; }
  .hx-brand { display:flex; align-items:center; gap:14px; }
  .hx-brand img { flex-shrink:0; border-radius:14px; }
  .hx-eyebrow { font-size:.72rem; font-weight:800; letter-spacing:.14em; line-height:1.6; }
  h1,h2,h3 { font-family:Georgia,'Times New Roman',serif; font-weight:400; }
  h1 { font-size:clamp(3rem,5.5vw,5rem); line-height:1.04; letter-spacing:-.055em; margin:26px 0; }
  h1 em,h2 em { color:#526b55; font-weight:400; }
  .hx-lede { max-width:32rem; font-size:1.15rem; line-height:1.7; }
  .hx-actions { display:flex; flex-wrap:wrap; gap:24px; align-items:center; margin-top:30px; }
  .hx-button { display:inline-flex; justify-content:center; align-items:center; gap:22px; background:#d7b86c; color:#172127; border:1px solid #a88d48; border-radius:7px; padding:15px 22px; font-weight:700; text-decoration:none; min-height:50px; transition:background .15s; }
  .hx-button:hover { background:#e8ca7f; }
  .hx-text-link { text-underline-offset:5px; font-size:.9rem; font-weight:700; }
  .hx-note { color:#58655c; font-size:.8rem; margin-top:25px; }
  .hx-hero-art { margin:0; border-radius:50% 50% 12px 12px; overflow:hidden; background:#172127; color:#f3eddf; transform:rotate(2deg); }
  .hx-hero-art img { width:100%; }
  .hx-hero-art figcaption { padding:21px 25px 25px; display:grid; gap:5px; }
  .hx-hero-art figcaption span { font-size:.65rem; letter-spacing:.16em; color:#d7b86c; }
  .hx-hero-art strong { font-family:Georgia,serif; font-size:1.65rem; font-weight:400; }
  .hx-hero-art i { font-size:.85rem; color:#c6cebf; }
  .hx-word-strip { background:#243633; color:#f3eddf; padding:30px 0; }
  .hx-word-inner { display:flex; justify-content:space-between; align-items:center; gap:24px; }
  .hx-word-inner p { font-size:1rem; line-height:1.8; }
  .hx-tiles { display:flex; gap:8px; flex-shrink:0; }
  .hx-tiles span { display:grid; place-items:center; width:49px; height:60px; border-radius:5px; background:#f3eddf; color:#243633; border-bottom:4px solid #b3a789; font:bold 1.6rem Georgia,serif; }
  .hx-tiles span:nth-child(2) { transform:rotate(-7deg) translateY(-4px); }
  .hx-tiles span:nth-child(5) { transform:rotate(7deg); }
  .hx-loop { padding-block:90px; scroll-margin-top:25px; }
  .hx-section-heading { max-width:730px; margin-bottom:50px; }
  h2 { font-size:clamp(2.2rem,4vw,3.5rem); letter-spacing:-.04em; line-height:1.12; margin:20px 0; }
  .hx-section-heading > p:last-child { max-width:570px; font-size:1.1rem; line-height:1.7; }
  h3 { font-size:1.5rem; line-height:1.2; margin:14px 0; }
  .hx-screenshots { display:flex; gap:24px; overflow-x:auto; scroll-snap-type:x mandatory; padding:4px 4px 24px; scrollbar-color:#a88d48 #e4dccb; }
  .hx-screen { display:block; flex:0 0 min(78vw,340px); scroll-snap-align:start; border:1px solid #c6b58f; border-radius:14px; overflow:hidden; background:#f1e5ce; box-shadow:0 8px 16px #24363312; }
  .hx-screen img { display:block; width:100%; height:auto; }
  .hx-screenshots:focus-visible { outline:2px solid #526b55; outline-offset:5px; }
  .hx-screen:focus-visible { outline:3px solid #526b55; outline-offset:1px; }
  .hx-caption { font-size:.8rem; color:#58655c; text-align:center; margin:28px 0 0; }
  .hx-beta { display:grid; grid-template-columns:1fr 1fr; gap:80px; padding-block:100px; align-items:center; }
  .hx-beta p { max-width:480px; line-height:1.7; }
  .hx-beta-details { padding-left:36px; border-left:1px solid #b6bdaa; }
  .hx-status { font-size:.68rem; font-weight:800; letter-spacing:.08em; color:#526b55; }
  .hx-support { display:block; margin-top:20px; font-size:.85rem; text-underline-offset:4px; }
  @media(max-width:900px) { .hx-hero { gap:28px; } .hx-beta { gap:36px; } }
  @media(max-width:700px) { .hx-hero { grid-template-columns:1fr; padding-block:30px 55px; gap:34px; } .hx-hero-art { width:min(100% - 12px,440px); justify-self:center; } .hx-word-inner { flex-direction:column; align-items:flex-start; } .hx-word-inner p { margin-top:0; } .hx-loop { padding-block:55px; } .hx-section-heading { margin-bottom:34px; } .hx-beta { grid-template-columns:1fr; padding-block:60px; gap:20px; } .hx-beta-details { border-left:0; border-top:1px solid #b6bdaa; padding:26px 0 0; } }
  @media(prefers-reduced-motion:reduce) { .hx-button { transition:none; } }
</style>
